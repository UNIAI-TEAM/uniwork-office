# Names only. Do not put production secrets in this file or commit real values.
# None of these are required to open, edit, or save documents.

# Electron userData isolation for tests / parallel instances
# GENOFFICE_USER_DATA=

# Optional search backends (keyless search is used when unset)
# SERPER_API_KEY=
# TAVILY_API_KEY=

# Packaging-only. Omit for UniWork GO-1 so updates and the font CDN stay off.
# GENOFFICE_UPDATE_URL=
# GENOFFICE_FONT_CDN_URL=

# Optional local overrides
# GENOFFICE_LANG=
# GENOFFICE_AUTH_DIR=
# GENOFFICE_AI_SETTINGS=
# GENOFFICE_APP_BIN=
# XLSX_SIDECAR_PATH=
# BUILD_DIR=
